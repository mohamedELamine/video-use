        {
          "id": "copy",
          "type": "string | run[]",
          "required": true,
          "source": "plan"
        }
      ],
      "primaryAssetRule": "none",
      "evidenceModes": ["stated", "supporting"]
    },
    {
      "id": "product-shot",
      "name": "Product Shot",
      "description": "Recorded interaction or visual state of a capability",
