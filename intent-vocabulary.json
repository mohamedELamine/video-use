    {
      "id": "state-change",
      "name": "State Change",
      "description": "Change the state of an element",
      "targetTypes": ["primary-asset-element"]
    },
    {
      "id": "camera",
      "name": "Camera",
      "description": "Move the camera to focus on an element",
      "targetTypes": ["primary-asset-element"]
    }
