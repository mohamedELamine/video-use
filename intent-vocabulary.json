        {
          "id": "heading",
          "type": "string",
          "required": false,
          "source": "plan"
        },
        {
          "id": "callout",
          "type": "string | run[]",
          "required": false,
          "source": "plan"
        }
      ],
      "primaryAssetRule": "required",
      "evidenceModes": ["recorded", "visual-state"]
    },
    {
      "id": "list",
      "name": "List",
      "description": "Enumeration of features or items",
      "slots": [
        {
          "id": "heading",
          "type": "string",
          "required": false,
          "source": "plan"
        },
        {
          "id": "items",
          "type": "string[]",
          "required": true,
          "source": "plan"
        }
      ],
      "primaryAssetRule": "none",
      "evidenceModes": ["stated"]
    },
    {
      "id": "feature",
      "name": "Feature",
      "description": "Highlighted product feature or capability",
      "slots": [
        {
          "id": "name",
          "type": "string",
          "required": true,
          "source": "plan"
        },
        {
          "id": "description",
          "type": "string",
          "required": false,
          "source": "plan"
        },
        {
          "id": "icon",
          "type": "string",
          "required": false,
          "source": "plan"
        }
      ],
      "primaryAssetRule": "none",
      "evidenceModes": ["stated"]
    },
    {
      "id": "stat",
      "name": "Stat",
      "description": "Numeric claim or metric",
      "slots": [
        {
          "id": "value",
          "type": "string",
          "required": true,
          "source": "plan"
        },
        {
          "id": "label",
          "type": "string",
          "required": false,
          "source": "plan"
        }
      ],
      "primaryAssetRule": "none",
      "evidenceModes": ["stated"]
